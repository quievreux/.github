{
    "name": "@quievreux/ui",
    "version": "0.1.0",
    "description": "Quievreux Design System - Icons & UI Components",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./styles": "./dist/styles/tokens.css"
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "restricted"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "lint": "eslint src/",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf dist"
    },
    "peerDependencies": {
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0",
        "lucide-react": ">=0.400.0"
    },
    "devDependencies": {
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "lucide-react": "^0.460.0",
        "react": "^18.2.0",
        "tsup": "^8.0.0",
        "typescript": "^5.3.0"
    },
    "keywords": [
        "quievreux",
        "design-system",
        "icons",
        "react",
        "tailwind"
    ],
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "https://github.com/quievreux/quievreux-shared.git",
        "directory": "packages/ui"
    }
}